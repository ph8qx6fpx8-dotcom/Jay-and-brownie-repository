# Copy to `.env` and fill in if you have partner API access.
# Both providers are partner-only; endpoint paths/field names may differ
# from what predictor/data_sources.py assumes — adjust the adapter to match
# your contract docs.

ARTNET_API_KEY=
ARTNET_BASE_URL=https://api.artnet.com/v1

MUTUALART_API_KEY=
MUTUALART_BASE_URL=https://api.mutualart.com/v1

# Apify token (apify.com → Settings → Integrations).
# Default actor is parseforge/artsy-scraper (Artsy gallery LISTINGS — asking
# prices, NOT realized auction sales). For auction data, override the actor
# in the app sidebar.
APIFY_API_TOKEN=
