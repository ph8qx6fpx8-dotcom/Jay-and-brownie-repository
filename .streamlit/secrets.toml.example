# When deploying to Streamlit Cloud, paste this content (with your real
# values) into: App settings → Secrets, in the Streamlit Cloud dashboard.
# Streamlit Cloud will load them at runtime and app.py copies them into
# os.environ so the data-source clients see them.
#
# DO NOT commit a real secrets.toml — only this .example file.

APIFY_API_TOKEN = "apify_api_xxxxxxxxxxxxxxxxxx"

# Optional — only needed if you have partner access:
ARTNET_API_KEY = ""
ARTNET_BASE_URL = "https://api.artnet.com/v1"

MUTUALART_API_KEY = ""
MUTUALART_BASE_URL = "https://api.mutualart.com/v1"
